# KernelSU support configuration fragment
# Applied on top of holi_QGKI.config for the OnePlus Nord N30 5G (larry / CPH2515)

# KernelSU core
CONFIG_KSU=y

# Required for KernelSU to resolve symbols at runtime
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Allow KPROBES-based hooks (preferred when available on holi/SM6375)
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# Enable overlayfs (required by KernelSU module mounting)
CONFIG_OVERLAY_FS=y

# Needed for KernelSU's namespace operations
CONFIG_USER_NS=y

# Enable eBPF (used by newer KernelSU versions)
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# Magic mount support
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
