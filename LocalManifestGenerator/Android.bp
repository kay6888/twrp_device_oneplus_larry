android_app {
    name: "LocalManifestGenerator",
    
    srcs: ["src/main/java/**/*.java"],
    
    resource_dirs: ["src/main/res"],
    
    manifest: "src/main/AndroidManifest.xml",
    
    platform_apis: true,
    
    certificate: "platform",
    
    privileged: true,
    
    optimize: {
        enabled: false,
    },
    
    dex_preopt: {
        enabled: false,
    },
}
